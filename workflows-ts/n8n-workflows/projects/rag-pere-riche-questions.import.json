{
  "name": "RAG Père riche père pauvre - Questions",
  "nodes": [
    {
      "id": "n0",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        -200,
        300
      ],
      "parameters": {
        "public": false,
        "options": {
          "responseMode": "lastNode"
        }
      }
    },
    {
      "id": "n1",
      "name": "Embedding de la question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        60,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'models/gemini-embedding-001', content: { parts: [{ text: $json.chatInput }] }, taskType: 'RETRIEVAL_QUERY' } }}",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Recherche Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        320,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://VOTRE_PROJECT_ID.supabase.co/rest/v1/rpc/match_documents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { query_embedding: '[' + $json.embedding.values.join(',') + ']', match_count: 5, filter: {} } }}",
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Regrouper les extraits",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        580,
        300
      ],
      "parameters": {
        "aggregate": "aggregateIndividualFields",
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "content"
            },
            {
              "fieldToAggregate": "metadata"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Préparer le contexte",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        840,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "question",
              "value": "={{ $('When chat message received').first().json.chatInput }}",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "contexte",
              "value": "={{ $json.content.map((c, i) => '[' + (i + 1) + '] (' + ($json.metadata[i]?.titre || 'sans titre') + ') ' + c).join('\\n\\n---\\n\\n') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n5",
      "name": "Réponse Gemini",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.8-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-3.8-flash"
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Question : ' + $json.question + '\\n\\nExtraits du livre :\\n' + $json.contexte }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "systemMessage": "Tu réponds en français à des questions sur un livre. Tu utilises uniquement les extraits fournis. Si la réponse n'y est pas, tu dis que tu ne la trouves pas dans le livre. Tu cites le numéro de l'extrait, par exemple [2]."
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "n6",
      "name": "Réponse",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1360,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "output",
              "value": "={{ $json.candidates?.[0]?.content?.parts?.[0]?.text || $json.content?.parts?.[0]?.text || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [
        [
          {
            "node": "Embedding de la question",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Embedding de la question": {
      "main": [
        [
          {
            "node": "Recherche Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recherche Supabase": {
      "main": [
        [
          {
            "node": "Regrouper les extraits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Regrouper les extraits": {
      "main": [
        [
          {
            "node": "Préparer le contexte",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Préparer le contexte": {
      "main": [
        [
          {
            "node": "Réponse Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Réponse Gemini": {
      "main": [
        [
          {
            "node": "Réponse",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": true
  }
}