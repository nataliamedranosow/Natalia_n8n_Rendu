{
  "name": "RAG Père riche père pauvre (v2 final)",
  "nodes": [
    {
      "id": "n0",
      "name": "Formulaire PDF",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        -200,
        300
      ],
      "parameters": {
        "formTitle": "Ajouter un livre",
        "formDescription": "Dépose un PDF avec du texte (pas un scan).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "data",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf",
              "requiredField": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n1",
      "name": "Extract",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        60,
        300
      ],
      "parameters": {
        "operation": "pdf",
        "options": {}
      }
    },
    {
      "id": "n2",
      "name": "Cleaning",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "texte_propre",
              "value": "={{ ($json.text || '').replace(/\\r/g,'').replace(/(\\w)-\\n(\\w)/g,'$1$2').replace(/[ \\t]+/g,' ').replace(/^\\s*\\d+\\s*$/gm,'').replace(/\\n{3,}/g,'\\n\\n').trim() }}",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "nom_fichier",
              "value": "={{ $('Formulaire PDF').item.binary.data.fileName }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "pages",
              "value": "={{ $json.numpages }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n3",
      "name": "Texte exploitable ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        580,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.texte_propre.length }}",
              "rightValue": 500,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n4",
      "name": "Erreur : PDF vide ou scanné",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        580,
        520
      ],
      "parameters": {
        "errorMessage": "Moins de 500 caractères extraits : le PDF est vide ou scanné (image). Utilise un PDF avec du texte."
      }
    },
    {
      "id": "n5",
      "name": "Chunking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ],
      "parameters": {
        "jsCode": "// Découpe par titres (Markdown ou titres détectés), sections de 5000 caractères maximum\nconst MAX = 5000;\nconst CHEVAUCHEMENT = 200;\nconst { texte_propre, nom_fichier } = $input.first().json;\n\nconst estTitre = (l) =>\n  /^#{1,6}\\s+\\S/.test(l) ||\n  /^(chapitre|chapter|partie|part|section)\\s+[\\dIVXivx]+/i.test(l) ||\n  (/^\\d+(\\.\\d+)*\\s+\\p{Lu}/u.test(l) && l.length < 80) ||\n  (l.length > 3 && l.length < 80 && l === l.toUpperCase() && /\\p{L}/u.test(l));\n\nconst sections = [];\nlet titre = 'Introduction';\nlet tampon = [];\nconst clore = () => {\n  const t = tampon.join('\\n').trim();\n  if (t) sections.push({ titre, texte: t });\n  tampon = [];\n};\nfor (const ligne of texte_propre.split('\\n')) {\n  const l = ligne.trim();\n  if (estTitre(l)) { clore(); titre = l.replace(/^#+\\s*/, ''); } else { tampon.push(ligne); }\n}\nclore();\n\nconst morceaux = [];\nfor (const sec of sections) {\n  if (sec.texte.length <= MAX) { morceaux.push({ titre: sec.titre, contenu: sec.texte }); continue; }\n  let courant = '';\n  for (const p of sec.texte.split(/\\n{2,}/)) {\n    if (courant && (courant + '\\n\\n' + p).length > MAX) {\n      morceaux.push({ titre: sec.titre, contenu: courant });\n      courant = courant.slice(-CHEVAUCHEMENT) + '\\n\\n' + p;\n    } else {\n      courant = courant ? courant + '\\n\\n' + p : p;\n    }\n    while (courant.length > MAX) {\n      morceaux.push({ titre: sec.titre, contenu: courant.slice(0, MAX) });\n      courant = courant.slice(MAX - CHEVAUCHEMENT);\n    }\n  }\n  if (courant) morceaux.push({ titre: sec.titre, contenu: courant });\n}\n\nreturn morceaux.map((m, i) => ({\n  json: { titre: m.titre, contenu: m.titre + '\\n\\n' + m.contenu, nom_fichier, index: i, total: morceaux.length },\n}));"
      }
    },
    {
      "id": "n6",
      "name": "Garder les morceaux utiles",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.3,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c2",
              "leftValue": "={{ $json.contenu.length }}",
              "rightValue": 100,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "n7",
      "name": "Supprimer les doublons",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ],
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "contenu",
        "options": {}
      }
    },
    {
      "id": "n8",
      "name": "Limit",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        1620,
        300
      ],
      "parameters": {
        "maxItems": 200,
        "keep": "firstItems"
      }
    },
    {
      "id": "n9",
      "name": "Chunking (SUB)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [
        1880,
        300
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": ""
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "n10",
      "name": "Chunking (Trigger)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        -200,
        700
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "n11",
      "name": "Augmentation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        60,
        700
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { systemInstruction: { parts: [{ text: \"Tu enrichis des extraits de livre pour la recherche documentaire. Tu n'inventes rien : tu t'appuies uniquement sur l'extrait.\" }] }, contents: [{ parts: [{ text: 'Voici un extrait d\\'un livre (section : ' + $json.titre + ').\\n\\n' + $json.contenu + '\\n\\nRéponds exactement en deux lignes, en français :\\nCONTEXTE: une phrase qui situe cet extrait dans le livre.\\nQUESTIONS: trois questions auxquelles cet extrait répond, séparées par \" | \".\\nMOTS-CLES: sept mots-clés importants, séparés par des virgules.' }] }] } }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 5000
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "n12",
      "name": "Préparer le texte",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        700
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0",
              "name": "augmentation",
              "value": "={{ $json.candidates?.[0]?.content?.parts?.[0]?.text || $json.content?.parts?.[0]?.text || '' }}",
              "type": "string"
            },
            {
              "id": "a1",
              "name": "texte_a_vectoriser",
              "value": "={{ $('Chunking (Trigger)').item.json.contenu + '\\n\\n' + ($json.candidates?.[0]?.content?.parts?.[0]?.text || $json.content?.parts?.[0]?.text || '') }}",
              "type": "string"
            },
            {
              "id": "a9",
              "name": "mots_cles",
              "value": "={{ (($json.candidates?.[0]?.content?.parts?.[0]?.text || $json.content?.parts?.[0]?.text || '').match(/MOTS-CL[EÉ]S\\s*:\\s*(.*)/i) || [])[1] || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "n13",
      "name": "Embedding",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        700
      ],
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'models/gemini-embedding-001', content: { parts: [{ text: $json.texte_a_vectoriser }] }, taskType: 'RETRIEVAL_DOCUMENT' } }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1000
            }
          }
        }
      }
    },
    {
      "id": "n14",
      "name": "Vecteur valide ?",
