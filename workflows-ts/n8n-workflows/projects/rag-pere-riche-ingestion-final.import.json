      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        840,
        920
      ],
      "parameters": {
        "errorMessage": "Le vecteur ne fait pas 3072 dimensions : le modèle d'embedding ne correspond pas à la table Supabase vector(3072)."
      }
    },
    {
      "id": "n16",
      "name": "Préparer la ligne",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1100,
