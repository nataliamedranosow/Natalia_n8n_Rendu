            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6127cad8-3b3f-4f95-8ee5-959f500d10e1",
      "name": "Associer les taux à chaque ville",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        640,
        96
      ],
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      }
    },
    {
      "id": "459afdb2-7c36-4e31-b7e1-a95be3ddda58",
      "name": "Calculer le score et convertir la monnaie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        96
      ],
      "parameters": {
        "jsCode": "const villes = $input.all().map(item => {\n  const d = item.json;\n\n  // Température moyenne du week-end\n  const tempMoyenne = (d.temps_samedi + d.temps_dimanche) / 2;\n\n  // Pire risque de pluie des deux jours\n  const pluieMax = Math.max(d.pluie_samedi, d.pluie_dimanche);\n\n  // Score : la chaleur fait monter le score, la pluie le fait baisser\n  const score = Math.round(tempMoyenne * 2 - pluieMax * 0.5);\n\n  // Taux de change : 1 si la ville est déjà en euros\n  const tauxChange = d.devise === \"EUR\" ? 1 : d.taux[d.devise];\n\n  // Combien valent 100 € dans la monnaie locale\n  const budget100 = Math.round(100 * tauxChange);\n\n  return {\n    json: {\n      ville: d.ville,\n      devise: d.devise,\n      temp_moyenne: Math.round(tempMoyenne * 10) / 10,\n      pluie_max: pluieMax,\n      score: score,\n      budget_100_eur: budget100\n    }\n  };\n});\n\n// Tri du meilleur score au moins bon\nvilles.sort((a, b) => b.json.score - a.json.score);\n\nreturn villes;"
      }
    },
    {
      "id": "77a0c339-1104-4c08-89b1-8dbf84ed3feb",
      "name": "Exclure les villes pluvieuses",
      "type": "n8n-nodes-base.filter",
