              "value": "={{ [\"Vienne\",\"Barcelone\",\"Lisbonne\",\"Rome\",\"Berlin\",\"Amsterdam\",\"Stockholm\",\"Athènes\",\"Dublin\",\"Bruxelles\"][$itemIndex] }}",
