              "leftValue": "={{ $json.pluie_max }}",
              "rightValue": "={{ 40 }}",
              "operator": {
                "type": "number",
                "operation": "lte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": "=",
        "options": {}
      }
    },
